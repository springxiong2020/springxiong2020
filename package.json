{
  "name": "spring-xiong",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\" \"*.{js,json,html}\" \"tests/**/*.js\" \"scripts/**/*.mjs\"",
    "format": "prettier --write \"src/**/*.{js,vue,css}\" \"*.{js,json,html}\" \"tests/**/*.js\" \"scripts/**/*.mjs\"",
    "lint": "eslint src tests scripts *.js --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run icons:check && npm run format:check && npm run lint && npm test && npm run build",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "axios": "^1.16.1",
    "pinia": "^3.0.4",
    "prettier": "^3.8.3",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.12",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
